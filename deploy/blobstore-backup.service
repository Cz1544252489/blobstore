[Unit]
Description=Back up the blobstore data directory to Google Drive, encrypted
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# BLOBSTORE_BACKUP_DEST, e.g. blobcrypt:hd; the script refuses to run without it.
EnvironmentFile=/etc/blobstore/backup
ExecStart=/usr/local/bin/blobstore-backup
